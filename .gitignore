# 忽略 Visual Studio 暫存檔與使用者設定
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# 忽略編譯產生的資料夾 (這是重點)
x64/
Debug/
Release/
*/x64/
*/Debug/
*/Release/

# 忽略編譯產生的暫存檔
*.obj
*.pdb
*.ipch
*.tlog
*.log
*.idb
*.ilk
*.exe
*.lib
*.dll

# 忽略 Python (如果有用到)
__pycache__/
*.pyc

# -----------------------------
# 忽略影像檔案 (Images)
# -----------------------------
*.png
*.jpg
*.jpeg
*.bmp
*.tiff
*.tif
*.gif
*.ico
*.svg
*.webp

# -----------------------------
# 忽略影片檔案 (Videos)
# -----------------------------
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm

# -----------------------------
# 忽略音訊檔案 (Audio)
# -----------------------------
*.mp3
*.wav
*.wma
*.m4a
*.flac
*.aac
*.ogg

# -----------------------------
# macOS 系統產生的隱藏垃圾檔
# -----------------------------
.DS_Store
.AppleDouble
.LSOverride

# 資源分岔檔 (Resource Forks) - 這在 Windows 上看起來像 "._檔名"
._*

# 資料夾顯示設定與暫存
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

